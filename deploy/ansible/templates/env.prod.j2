# Rendered by Ansible on the droplet. Do not edit by hand.
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
DATABASE_URL=postgres://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}?sslmode=disable

BASE_URL={{ public_url | default('http://' + inventory_hostname) }}
ALLOWED_ORIGINS={{ public_url | default('http://' + inventory_hostname) }}
LOG_LEVEL=info

JWT_SECRET={{ jwt_secret }}
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=168h
COOKIE_SECURE={{ cookie_secure | default('false') }}

GRAFANA_ADMIN_USER={{ grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
