# Copy to vars.yml and fill in real secrets. vars.yml is gitignored.
postgres_user: shortlink
postgres_password: change-me-to-a-strong-password
postgres_db: shortlink
jwt_secret: change-me-to-at-least-32-random-bytes-0123456789
grafana_admin_user: admin
grafana_admin_password: change-me-grafana-admin

jenkins_admin_id: admin
jenkins_admin_password: change-me-jenkins-admin

# Public URL of the app. Default is http://<droplet_ip>. With a domain + HTTPS
# (Caddy), set the https URL and cookie_secure: "true".
# public_url: https://shortlink.example.xyz
# cookie_secure: "true"

# Optional: to pull private GHCR images set a GitHub PAT with read:packages.
# Leave empty if the images are public.
ghcr_user: kytruongdev
ghcr_pat: ""
