# Copy to deploy/.env.prod and fill in real values. Never commit deploy/.env.prod.

# --- Postgres ---
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=shortlink

# --- Backend ---
# Host is the compose service name "postgres" (internal network).
DATABASE_URL=postgres://shortlink:change-me-to-a-strong-password@postgres:5432/shortlink?sslmode=disable

# Public origin used to build short URLs and for CORS. Single-origin deploy:
# this is the address users open in the browser (nginx front door).
#   local test : http://localhost
#   VPS (HTTP) : http://<EC2_PUBLIC_IP>
#   VPS (HTTPS): https://<your-domain>   (then set COOKIE_SECURE=true)
BASE_URL=http://localhost
ALLOWED_ORIGINS=http://localhost

LOG_LEVEL=info

# --- Auth ---
JWT_SECRET=change-me-to-at-least-32-random-bytes-0123456789
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=168h
# false over plain HTTP (Secure cookies are not sent without TLS); true once HTTPS is on.
COOKIE_SECURE=false
